# Copie para .env e preencha. NUNCA versione o .env (está no .gitignore).
# Valores de produção: ALLOY_ENV=prod exige todos os segredos abaixo (o backend recusa subir sem eles).

# --- ambiente --------------------------------------------------------------
ALLOY_ENV=prod
ALLOY_DEMO=proibido
ALLOY_DOMINIO=alloy.exemplo.edu.br
ALLOY_VERSAO=0.9.0

# --- banco (o compose monta DATABASE_URL a partir destes) -------------------
POSTGRES_DB=alloy
POSTGRES_USER=alloy
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# --- segredos (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
ALLOY_SESSION_SECRET=
ALLOY_CSRF_SECRET=

# --- opcionais ---------------------------------------------------------------
# ALLOY_CORS_ORIGINS=[]          # mesmo domínio: CORS desnecessário (ADR-011)
# ALLOY_RATE_LIMIT_REQUESTS=120
# ALLOY_RATE_LIMIT_WINDOW_SECONDS=60
# ALLOY_MAX_BODY_BYTES=1048576
# ALLOY_COOKIE_SECURE=true       # obrigatório em prod
# ALLOY_DOCS=false               # /api/v1/docs desligado em prod por padrão
